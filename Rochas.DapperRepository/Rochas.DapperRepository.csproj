<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Copyright>Renato Rocha</Copyright>
    <Authors>Renato Rocha</Authors>
    <Company></Company>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RepositoryType>Git</RepositoryType>
    <RepositoryUrl>https://github.com/rocha83/DapperRepository</RepositoryUrl>
    <PackageProjectUrl>https://github.com/rocha83/DapperRepository</PackageProjectUrl>
    <PackageTags>dapper light lightweight generic repository entity entities database sql sqlserver mysql postgresql sqlite cache cacheable elastic tokenized search bulk persistence parser crud poco orm cqrs builder pattern fluent api</PackageTags>
    <Version>2.0.0</Version>
    <Description>A lightweight generic entities cacheable repository using Dapper</Description>
    <PackageLicenseFile>GNUv2_License.txt</PackageLicenseFile>
    <PackageIcon>orm-icon.png</PackageIcon>
    <PackageReleaseNotes>v2.0.0 (data-toolkit): contract dependency migrated to Rochas.Data.Specification 2.0.0 (namespace Rochas.Data.Specification.*). SQL translation (EntitySqlParser/EntityReflector/Helpers.SQL) unified to Rochas.SqlWrapper 2.0.0 — the duplicated ORM-internal parser was removed. Implements IGenericBwoqRepository&lt;T&gt; (BWOQ grammar Q/W/G/O/OD via Rochas.BWOQ 2.0.0). [FIX] GROUP BY + aggregates now applied in paginated queries. IPersistenceRepository&lt;T&gt; extracted as base contract. Previous: v1.9.5 - [NEW] GroupBy(groupAttributes, aggregates) now applies dictionary aggregates (SUM/COUNT/AVG/MIN/MAX) to grouped queries; aggregates previously ignored by the builder.</PackageReleaseNotes>
    <Title>Dapper Generic Repository</Title>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="Npgsql" Version="8.0.9" />
    <ProjectReference Include="..\..\BWOQ\Rochas.BWOQ\Rochas.BWOQ.csproj" />
    <ProjectReference Include="..\..\DataSpecification\Rochas.Data.Specification\Rochas.Data.Specification.csproj" />
    <ProjectReference Include="..\..\SqlWrapper\Rochas.SqlWrapper\Rochas.SqlWrapper.csproj" />
    <PackageReference Include="System.ComponentModel" Version="4.3.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.18" />
    <PackageReference Include="System.Text.Json" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GNUv2_License.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="orm-icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
