<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Copyright>Renato Rocha</Copyright>
    <Authors>Renato Rocha</Authors>
    <Company></Company>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RepositoryType>Git</RepositoryType>
    <RepositoryUrl>https://github.com/rocha83/DapperRepository</RepositoryUrl>
    <PackageProjectUrl>https://github.com/rocha83/DapperRepository</PackageProjectUrl>
    <PackageTags>dapper light lightweight generic repository entity entities database sql sqlserver mysql postgresql sqlite cache cacheable elastic tokenized search bulk persistence parser crud poco orm cqrs builder pattern fluent api</PackageTags>
    <Version>1.8.6</Version>
    <Description>A lightweight generic entities cacheable repository using Dapper</Description>
    <PackageLicenseFile>GNUv2_License.txt</PackageLicenseFile>
    <PackageIcon>orm-icon.png</PackageIcon>
    <PackageReleaseNotes>v1.8.6 - Builder Pattern and ORM Hardening: [NEW] IQueryBuilder, IQuerySyncBuilder, IQueryPaginatedBuilder with fluent API; [NEW] OrderBy/OrderByDescending with params string[]; [NEW] GroupBy with aggregates support; [NEW] Paginate() on IQueryPaginatedBuilder; [NEW] ToList() on IQuerySyncBuilder and IQueryPaginatedBuilder; [NEW] GuidStringHandler centralized with EnsureRegistered(); [NEW] Enum values serialized as int; [FIX] FillComposition cycle detection by entity identity (type + PK) prevents infinite recursion on circular RelatedEntity references; [FIX] FillComposition OneToMany null guard when FK not resolvable; [FIX] DataBaseConnection.Dispose transaction-before-connection order with uncommitted transaction rollback safety; [FIX] Transaction Dispose prevents database locks; [FIX] Disconnect with Dispose and connection null; [FIX] PersistComposition always disconnects after commit; [FIX] FillComposition recursion support; [FIX] ParseComposition supports ReadOnlyCollection; [FIX] Enum to int conversion; [FIX] BaseEntity default constructor sets CreatedAt; [PERF] EntityPropsCache - cached filtered PropertyInfo[] per entity type; [PERF] ColumnMappingCache for sort/group SQL generation; [PERF] SQL Dump only in DEBUG builds</PackageReleaseNotes>
    <Title>Dapper Generic Repository</Title>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="Npgsql" Version="8.0.8" />
    <ProjectReference Include="..\Rochas.DapperRepository.Specification\Rochas.DapperRepository.Specification.csproj" />
    <PackageReference Include="System.ComponentModel" Version="4.3.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="System.Text.Json" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GNUv2_License.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="orm-icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
