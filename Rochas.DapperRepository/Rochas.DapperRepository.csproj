<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Copyright>Renato Rocha</Copyright>
    <Authors>Renato Rocha</Authors>
    <Company></Company>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RepositoryType>Git</RepositoryType>
    <RepositoryUrl>https://github.com/rocha83/DapperRepository</RepositoryUrl>
    <PackageProjectUrl>https://github.com/rocha83/DapperRepository</PackageProjectUrl>
    <PackageTags>dapper light lightweight generic repository entity entities database sql sqlserver mysql postgresql sqlite cache cacheable elastic tokenized search bulk persistence parser crud poco orm cqrs builder pattern fluent api</PackageTags>
    <Version>2.0.4</Version>
    <Description>A lightweight generic entities cacheable repository using Dapper</Description>
    <PackageLicenseFile>GNUv2_License.txt</PackageLicenseFile>
    <PackageIcon>orm-icon.png</PackageIcon>
    <PackageReadmeFile></PackageReadmeFile>
    <PackageReleaseNotes>v2.0.4 - Connection/transaction lifecycle: AddRangeSync commits before disconnect; Commit/Cancel no longer flip keepConnection; CompositeCommand attaches live transactions only; PersistComposition honors keep-alive. Dependency refresh: Dapper 2.1.79 -&gt; 2.1.89; Microsoft.Data.Sqlite 9.0.18 -&gt; 10.0.12; Microsoft.Data.SqlClient 6.1.1 -&gt; 7.1.0; System.Text.Json 9.0.18 -&gt; 10.0.12; MySqlConnector 2.6.1 -&gt; 2.6.2; Rochas.BWOQ 1.6.6 -&gt; 1.6.8 (package icon); Rochas.SqlWrapper 1.4.9 -&gt; 1.5.0 (statement cache, dotless-namespace fix — via NuGet). v2.0.3 - Rochas.SqlWrapper 1.4.8 -&gt; 1.4.9 (DateOnly/TimeOnly as quoted ISO literals); Rochas.BWOQ 1.6.5 -&gt; 1.6.6. v2.0.2 - Async/sync path separation: new FillCompositionAsync (no more sync-over-async hangs on cyclic compositions), truly-async paginated builder, path-based cycle guard with depth cap, paged queries now honor loadComposition, sync APIs run on sync executors; PostgreSQL inserts with client-generated keys skip lastval (55000 fallback); GuidStringHandler registered for all engines (TEXT Guid PKs on PG). v2.0.1 - Rochas.SqlWrapper 1.1.2 -&gt; 1.4.8 (PostgreSQL-valid GROUP BY + EntityReflector with cache). v2.0.0 - [NEW] PostgreSQL support in CompositeCommand (parameterized Query/Search Paginate, Add, Update and Remove now run on Npgsql: null maps to DBNull, Guid maps to text following GuidStringHandler); test project now consumes Rochas.CacheIndexer 1.1.0 from NuGet instead of a local ProjectReference. v1.9.8 - Contracts moved to Rochas.Data.Specification (DataSpecification), replacing the internal Rochas.DapperRepository.Specification project. </PackageReleaseNotes>
    <Title>Dapper Generic Repository</Title>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="8.0.9" />
    <PackageReference Include="Rochas.Data.Specification" Version="1.6.3" />
    <PackageReference Include="Rochas.SqlWrapper" Version="1.5.0" />
    <PackageReference Include="Rochas.BWOQ" Version="1.6.8" />
    <PackageReference Include="System.ComponentModel" Version="4.3.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GNUv2_License.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="orm-icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
