<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Copyright>Renato Rocha</Copyright>
    <Authors>Renato Rocha</Authors>
    <Company></Company>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RepositoryType>Git</RepositoryType>
    <RepositoryUrl>https://github.com/rocha83/DapperRepository</RepositoryUrl>
    <PackageProjectUrl>https://github.com/rocha83/DapperRepository</PackageProjectUrl>
    <PackageTags>dapper light lightweight generic repository entity entities database sql sqlserver mysql postgresql sqlite cache cacheable elastic tokenized search bulk persistence parser crud poco orm cqrs builder pattern fluent api</PackageTags>
    <Version>1.7.4</Version>
    <Description>A lightweight generic entities cacheable repository using Dapper</Description>
    <PackageLicenseFile>GNUv2_License.txt</PackageLicenseFile>
    <PackageIcon>orm-icon.png</PackageIcon>
    <PackageReleaseNotes>v1.7.4: Query() returns IQueryBuilder (awaitable, fluent OrderBy/GroupBy); QueryPaginated() returns IQueryPaginatedBuilder; QueryRaw/QueryRawSync with SQL injection prevention (SELECT only, no semicolons, no comments, no DDL/DML); OrderBy and GroupBy accept string[]; RelationalColumn and DataAggregationColumn for ETL/DW fact queries; DataAggregationColumn excluded from WHERE; null-safe range filter; Pluggable cache providers (ICacheProvider); parameterized queries; reflection caching; [Key] attribute for PK + _id suffix convention for FK detection. v1.6.8: date range by value type; null-safe ranges; empty string exclusion; KeyColumns cache by entity type; array skip. v1.6.6: [Table] and [Column] optional; enum as string literals; empty strings as ''; PostgreSQL compliant.</PackageReleaseNotes>
    <Title>Dapper Generic Repository</Title>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="Npgsql" Version="8.0.8" />
    <PackageReference Include="Rochas.DapperRepository.Specification" Version="1.4.8" />
    <PackageReference Include="System.ComponentModel" Version="4.3.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="System.Text.Json" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GNUv2_License.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="orm-icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
